# ---------------------------------------------------------------------------
# Concord ChemTrack - Environment Variables
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` - it is git-ignored on purpose.
# ---------------------------------------------------------------------------

# Public Supabase project URL - safe to expose (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase anon/publishable key - safe to expose (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key - SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit.
# Used by the server to read the private `users` table.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Secret used to sign the session JWT (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=replace-with-a-long-random-string
